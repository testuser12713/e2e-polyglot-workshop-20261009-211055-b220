{
  "runcontract": 1,
  "services": [
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [["npm", "ci", "--no-audit", "--no-fund"]],
      "build": [["npm", "run", "build"]],
      "test": [["npm", "test", "--", "--run"]],
      "start": ["npm", "run", "preview", "--", "--port", "${PORT}", "--host", "127.0.0.1", "--strictPort"],
      "port": 5173,
      "port_env": "PORT",
      "health": { "path": "/", "expect_status": [200] },
      "env": {
        "VITE_API_BASE_URL": { "dev": "${service:api.origin}" }
      }
    }
  ]
}
