{
  "runcontract": 1,
  "services": [
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        [
          "npm",
          "ci",
          "--no-audit",
          "--no-fund"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "test": [
        [
          "npm",
          "test",
          "--",
          "--run"
        ]
      ],
      "start": [
        "npm",
        "run",
        "preview",
        "--",
        "--port",
        "${PORT}",
        "--host",
        "127.0.0.1",
        "--strictPort"
      ],
      "port": 5173,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [
          200
        ]
      },
      "env": {
        "VITE_API_BASE_URL": {
          "dev": "${service:api.origin}"
        }
      }
    },
    {
      "name": "api",
      "dir": "backend",
      "stack": "go",
      "kind": "server",
      "install": [
        [
          "go",
          "mod",
          "download"
        ]
      ],
      "build": [
        [
          "go",
          "build",
          "./..."
        ]
      ],
      "test": [
        [
          "go",
          "test",
          "./..."
        ]
      ],
      "lint": [
        [
          "go",
          "vet",
          "./..."
        ]
      ],
      "start": [
        "go",
        "run",
        "./cmd/api"
      ],
      "port": 8000,
      "port_env": "PORT",
      "ready_timeout_s": 60,
      "health": {
        "path": "/api/health",
        "expect_status": [
          200
        ]
      },
      "depends_on": [
        "db",
        "queue"
      ],
      "env": {
        "DATABASE_URL": {
          "dev": "${service:db.url}"
        },
        "VALKEY_URL": {
          "dev": "${service:queue.url}"
        },
        "HOUR_RATE_CENTS": {
          "dev": "6500"
        },
        "FRONTEND_ORIGIN": {
          "dev": "http://localhost:5173"
        },
        "AUTH_SECRET": {
          "generate": "hex",
          "bytes": 32
        },
        "SEED_EMPLOYEE_EMAIL": {
          "dev": "werkstatt@example.com",
          "not_secret": true,
          "why": "The e-mail address of the seeded workshop account is a public login identifier, not a credential; the password is the secret."
        },
        "SEED_EMPLOYEE_PASSWORD": {
          "generate": "hex",
          "bytes": 16
        }
      }
    },
    {
      "name": "worker",
      "dir": "worker",
      "stack": "python",
      "kind": "worker",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "test": [
        [
          "${python}",
          "-m",
          "pytest",
          "-q"
        ]
      ],
      "start": [
        "${python}",
        "-m",
        "worker.main"
      ],
      "depends_on": [
        "db",
        "queue"
      ],
      "env": {
        "DATABASE_URL": {
          "dev": "${service:db.url}"
        },
        "VALKEY_URL": {
          "dev": "${service:queue.url}"
        },
        "HOUR_RATE_CENTS": {
          "dev": "6500"
        },
        "INVOICE_QUEUE": {
          "dev": "invoices"
        },
        "PYTHONPATH": {
          "dev": ".."
        }
      }
    },
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "queue",
      "kind": "database",
      "engine": "valkey"
    }
  ]
}
