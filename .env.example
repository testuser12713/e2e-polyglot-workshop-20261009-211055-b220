# Environment for the API service (backend/).
#
# Copy this file and load it in your shell:
#
#     cp .env.example .env
#     set -a; . ./.env; set +a
#
# The two secrets are generated on the spot by the `$(...)` commands, so no
# secret value is ever stored in this repository. Load the file with a POSIX
# shell (source/dot) — a plain dotenv parser would keep the command text — or
# generate the values yourself with the commands noted next to each secret.

# PostgreSQL and Valkey from compose.yaml (`docker compose up -d`).
DATABASE_URL=postgres://workshop@localhost:5432/workshop?sslmode=disable
VALKEY_URL=redis://localhost:6379/0

PORT=8000
HOUR_RATE_CENTS=6500
FRONTEND_ORIGIN=http://localhost:5173

# HS256 signing key for the bearer tokens (generate: openssl rand -hex 32).
AUTH_SECRET=$(openssl rand -hex 32)

# The first workshop employee. The seed runs once at startup while the
# employees table is empty; a restart never overwrites the account.
SEED_EMPLOYEE_EMAIL=werkstatt@example.com
# Password of the seeded account (generate: openssl rand -hex 16).
SEED_EMPLOYEE_PASSWORD=$(openssl rand -hex 16)
